    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "clsx": "^2.1.1",
    "effect": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "gt-react": "^11.4.16",
    "gt-tanstack-start": "^11.4.16",
    "motion": "^14.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
