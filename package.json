{
  "name": "wordle-game-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "vp preview",
    "preview": "vp preview",
    "lint": "vp lint",
    "test": "vp test --reporter=verbose",
    "type-check": "tsc --noEmit",
    "gt:generate": "gt generate",
    "gt:validate": "gt validate",
    "seed-sol-en": "vpx ./src/seed/solutions-en.ts",
    "seed-sol-pl": "vpx ./src/seed/solutions-pl.ts",
    "seed-def-en": "vpx ./src/seed/definitions-en.ts",
    "seed-def-pl": "vpx ./src/seed/definitions-pl.ts",
