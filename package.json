    "sync-pl": "vpx ./src/seed/sync-pl.ts",
    "seed-dic-en": "vpx ./src/seed/dictionary-en.ts",
    "seed-dic-pl": "vpx ./src/seed/dictionary-pl.ts",
    "db:migrate": "vpx ./src/seed/run-migrations.ts",
    "cloudflare-plan-proof": "vpx ./src/seed/cloudflare-plan-proof.ts",
    "riddle-prompt-ab": "vpx ./src/seed/riddle-prompt-ab.ts",
    "upload": "npm run build && wrangler versions upload --preview-alias staging",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
