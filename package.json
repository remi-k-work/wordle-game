{
  "name": "wordle-game-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest --reporter=verbose",
    "type-check": "tsc --noEmit",
    "gt:generate": "gt generate",
    "gt:translate": "gt translate",
    "seed-sol-en": "tsx ./src/seed/solutions-en.ts",
    "seed-sol-pl": "tsx ./src/seed/solutions-pl.ts",
    "seed-def-en": "tsx ./src/seed/definitions-en.ts",
    "seed-def-pl": "tsx ./src/seed/definitions-pl.ts",
    "sync-en": "tsx ./src/seed/sync-en.ts",
    "sync-pl": "tsx ./src/seed/sync-pl.ts",
    "seed-dic-en": "tsx ./src/seed/dictionary-en.ts",
    "seed-dic-pl": "tsx ./src/seed/dictionary-pl.ts",
    "db:migrate": "tsx ./src/seed/run-migrations.ts",
    "upload": "npm run build && wrangler versions upload --preview-alias staging",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@effect/ai-openai-compat": "^4.0.6",
    "@effect/ai-openrouter": "^4.0.6",
    "@effect/atom-react": "^4.0.6",
    "@effect/platform-browser": "^4.0.6",
    "@effect/platform-node": "^4.0.6",
    "@effect/sql-pg": "^4.0.6",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "clsx": "^2.1.1",
    "effect": "^4.0.6",
    "embla-carousel-react": "^8.6.0",
    "gt-react": "^11.4.14",
    "gt-tanstack-start": "^11.4.14",
    "motion": "^14.6.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@effect/tsgo": "0.56.0",
    "@effect/vitest": "^4.0.6",
    "@statelyai/inspect": "^0.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "gt": "^2.26.6",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "tree-sitter-python@0.25.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true,
    "protobufjs@7.6.6": true
  }
}
