{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  // Effect recommended preset: enables type-aware mode + effecttsgo rules.
  // See https://effect.website/docs/v4/getting-started/devtools#oxlint
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  // Tight scope: closest clean equivalent of `eslint-config-next/core-web-vitals`
  // + `eslint-config-next/typescript` (react, react-hooks, nextjs, jsx-a11y,
  // typescript, import, vitest). No unicorn/oxc extras, no JS-plugin compat layer.
  "plugins": ["eslint", "typescript", "react", "nextjs", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2023": true
  },
  // Mirrors the old eslint.config.mjs globalIgnores plus local scratch/dict files.
  // node_modules and .git are ignored by default; .gitignore is respected automatically.
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts", ".repos/**", "_scratchpad/**", "src/seed/dictionary-pl.txt"],
  "settings": {
    // Oxlint has no "detect"; pin to the installed React version.
    "react": {
      "version": "19.2.8"
    }
  },
  "rules": {
    // --- Next.js core-web-vitals parity ---
    // Oxlint rule names drop the `@next/next` prefix.
    // core-web-vitals upgrades these two to error (rest of recommended stays warn/error via correctness).
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-sync-scripts": "error",
    // --- eslint-config-next downgrades / modern-JSX opts ---
    "react/no-unknown-property": "off",
    "react/react-in-jsx-scope": "off",
    // NOTE: eslint-config-next also sets `react/prop-types: off`, but Oxlint
    // deliberately does not implement `react/prop-types` (React 19 ignores
    // PropTypes; TypeScript covers props), so there is nothing to disable.
    "react/jsx-no-target-blank": "off",
    // --- typescript-eslint parity (next/typescript sets these to warn) ---
    "typescript/no-unused-vars": "warn",
    "typescript/no-unused-expressions": "warn",
    "typescript/no-explicit-any": "warn",
    // --- import parity ---
    "import/no-anonymous-default-export": "warn",
    // --- @effect/vitest support ---
    // Tests use `it.effect(...)`; teach the rule these are test blocks so the
    // rule keeps working as intended instead of false-positive errors.
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "test.effect", "test.live", "test.scoped"]
      }
    ],
    // --- Downgraded to warn: valuable type-aware / Effect rules that fire on
    // pre-existing code and would need invasive, unrelated refactors to fix.
    // They stay visible without blocking `npm run lint`.
    // XState `assign(({ context }) => ({ ...context, ... }))` idiom.
    "typescript/no-misused-spread": "warn",
    // Translation values / chart formatters typed as `unknown`.
    "typescript/restrict-template-expressions": "warn",
    "typescript/no-base-to-string": "warn",
    // Architectural Effect guidance; matches Effect's own correctness preset.
    "effecttsgo/any-unknown-in-error-context": "warn",
    // --- Disabled: not part of the old eslint-config-next coverage ---
    // Base UI Switch carries its own aria-label; the rule can't see through it.
    "jsx-a11y/label-has-associated-control": "off",
    // Prefers `<output>` over role="status"; motion.p markup is intentional.
    "jsx-a11y/prefer-tag-over-role": "off"
    // react-hooks (rules-of-hooks, exhaustive-deps) and the 5 jsx-a11y rules
    // enabled by eslint-config-next are covered by the plugins + correctness category.
    // Existing `eslint-disable` comments keep working (respected by default).
  }
}
